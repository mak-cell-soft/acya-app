{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MasterConnection": "Host=localhost;Database=acya-app-bo;Username=postgres;Password=${POSTGRES_PASSWORD}"
  },
  "JwtSettings": {
    "Secret": "${JWT_SECRET}",
    "Issuer": "acya-bo",
    "Audience": "acya-bo-ui",
    "ExpirationInMinutes": 1440
  },
  "HealthCheck": {
    "Services": [
      {
        "Name": "elance-app.ui (Frontend)",
        "Url": "http://migration-ui:3000"
      },
      {
        "Name": "wood-app-api (Backend API)",
        "Url": "http://wood-app-api:80/api/ApiHealth/HealthCheck"
      }
    ]
  },
  "WoodSeedScriptPath": "/app/db/wood/v0.10/seed_natural_wood.sql.template"
}
