# ==============================================================================
# ACYA Root Production & Deployment Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' on your production server:
#      cp .env.example .env
# 2. Restrict permissions immediately (Unix/Linux):
#      chmod 600 .env
# 3. Fill in all placeholder values with cryptographically secure credentials.
# 4. NEVER commit the real '.env' to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL) Credentials
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
POSTGRES_DB=wood-app-db
APP_DB=app-db-bo

# ------------------------------------------------------------------------------
# 2. JWT Secrets
# Generate with: openssl rand -base64 64
# ------------------------------------------------------------------------------
# Main tenant API JWT Secret (must match ClientJwtSettings in admin-api)
JWT_SECRET_MAIN=REPLACE_WITH_SECURE_RANDOM_STRING_MIN_64_CHARS

# SuperAdmin Backoffice JWT Secret (used exclusively by bo-acya-app)
JWT_SECRET_ADMIN=REPLACE_WITH_ANOTHER_SECURE_RANDOM_STRING_MIN_64_CHARS

# ------------------------------------------------------------------------------
# 3. Email & Integration Services
# ------------------------------------------------------------------------------
# n8n Webhook / Email Workflow Automation API Key
N8N_EMAIL_SERVICE_API_KEY=REPLACE_WITH_N8N_API_KEY

# Mailgun / External Webhook Inbound Validation Key
MAILGUN_WEBHOOK_SIGNING_KEY=REPLACE_WITH_MAILGUN_WEBHOOK_SIGNING_KEY

# SMTP Outbound Email Credentials (used by wood-app.api)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_SENDER_NAME="ACYA Notification"
SMTP_SENDER_EMAIL=notifications@acya.site
SMTP_USERNAME=notifications@acya.site
SMTP_PASSWORD=REPLACE_WITH_SMTP_APP_PASSWORD
SMTP_ENABLE_SSL=true

# ------------------------------------------------------------------------------
# 4. TEJ Integration Credentials
# ------------------------------------------------------------------------------
TEJ_USERNAME=REPLACE_WITH_TEJ_PORTAL_USERNAME
TEJ_PASSWORD=REPLACE_WITH_TEJ_PORTAL_PASSWORD
