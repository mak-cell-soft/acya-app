#!/usr/bin/env python3
"""ACYA Phase 11B Production Backup Runner CLI (`/opt/acya-backup/bin/acya-backup-runner`)."""

import argparse
import json
import os
import sys

_HERE = os.path.dirname(os.path.realpath(__file__))
_LIB = os.path.normpath(os.path.join(_HERE, "..", "lib"))
if os.path.isdir(_LIB) and _LIB not in sys.path:
    sys.path.insert(0, _LIB)

from acya_backup.config import load_config
from acya_backup.errors import BackupError, ExitCode
from acya_backup.pipeline import BackupRunner


def main(argv=None):
    parser = argparse.ArgumentParser(
        prog="acya-backup-runner",
        description="ACYA Phase 11B Production Backup Runner (Admin-Dash v3.2 aligned).",
    )
    parser.add_argument(
        "--config",
        default="/opt/acya-backup/config/backup.json",
        help="Path to backup.json configuration file.",
    )
    parser.add_argument(
        "--mode",
        choices=("full", "preflight", "stage-only", "lock-inspect"),
        default="full",
        help="Execution mode (default: full).",
    )
    parser.add_argument(
        "--trigger",
        choices=("manual", "systemd-timer", "test"),
        default="manual",
        help="Execution trigger label recorded in telemetry.",
    )
    parser.add_argument(
        "--skip-remote",
        action="store_true",
        help="Skip remote repository probe and lock inspection (only valid for preflight or stage-only).",
    )
    parser.add_argument(
        "--print-telemetry",
        action="store_true",
        help="Print final telemetry JSON record to stdout upon completion.",
    )
    args = parser.parse_args(argv)

    if args.skip_remote and args.mode in ("full", "lock-inspect"):
        sys.stderr.write("ERROR: --skip-remote cannot be combined with --mode full or --mode lock-inspect\n")
        return ExitCode.CONFIG

    try:
        cfg = load_config(args.config)
    except BackupError as berr:
        sys.stderr.write(f"CONFIG ERROR [{berr.category}]: {berr.message}\n")
        return berr.exit_code

    runner = BackupRunner(
        cfg,
        mode=args.mode,
        trigger=args.trigger,
        skip_remote=args.skip_remote,
    )
    rc, record = runner.execute()
    if args.print_telemetry:
        print(json.dumps(record, indent=2))
    return rc


if __name__ == "__main__":
    sys.exit(main())

